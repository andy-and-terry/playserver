DGX_API_TOKEN=changeme
OLLAMA_BASE_URL=http://ollama:11434
DATA_DIR=./data
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_MB=200

# ── Firewall ──────────────────────────────────────────────────────────────────
# Set to false to disable the application-level firewall entirely
FIREWALL_ENABLED=true

# Comma-separated IPs or CIDRs to BLOCK (e.g. "10.0.0.5,192.168.2.0/24")
# Leave empty to block nothing
BLOCKED_IPS=

# Comma-separated IPs or CIDRs to ALLOW (e.g. "192.168.1.0/24")
# Leave empty to allow all IPs (recommended for local dev)
ALLOWED_IPS=

# Maximum requests per IP per minute (0 = rate limiting disabled)
RATE_LIMIT_PER_MINUTE=60
